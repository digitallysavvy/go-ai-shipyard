# Copy to .env and set at least one key. Each key enables one pairing in the UI.

# Claude pairing: an Anthropic chat model hands code changes to Claude Code.
ANTHROPIC_API_KEY=

# Codex pairing: an OpenAI chat model hands code changes to Codex.
OPENAI_API_KEY=

# Optional overrides.
# CLAUDE_CHAT_MODEL=claude-sonnet-5-5
# CLAUDE_CODE_MODEL=claude-sonnet-5-5
# OPENAI_CHAT_MODEL=gpt-6-astra
# CODEX_MODEL=
# Keeps pending approvals valid across server restarts.
# TOOL_APPROVAL_SECRET=
# PORT=8080
# WEB_ORIGIN=http://localhost:3000
